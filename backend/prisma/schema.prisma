// Prisma schema for MentorConnect – AI-Powered Goal-Based Mentoring Platform
// Configured for PostgreSQL database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  STUDENT
  MENTOR
  ADMIN
  GUARDIAN
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum MilestoneStatus {
  PENDING
  COMPLETED
}

enum MentorshipStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum MentorStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MentorType {
  PROFESSIONAL
  PEER
}

enum PaymentStatus {
  CREATED
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PayoutStatus {
  PENDING
  ELIGIBLE
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

enum AssignmentStatus {
  ASSIGNED
  SUBMITTED
  REVIEWED
  RETURNED
}

enum SubmissionStatus {
  NOT_SUBMITTED
  SUBMITTED
  REVIEWED
  LATE
}

enum ComplaintStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum ComplaintCategory {
  INAPPROPRIATE_BEHAVIOR
  NO_SHOW
  PAYMENT_ISSUE
  OTHER
}

enum NotificationType {
  SESSION_REMINDER
  MENTORSHIP_REQUEST
  PAYMENT
  ASSIGNMENT
  COMPLAINT
  GENERAL
}

enum MentorAppStatus {
  PENDING
  AI_SCREENED
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum CredentialStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ReviewerRole {
  STUDENT
  MENTOR
}

enum AIRecommendationType {
  ROADMAP
  MENTOR
  MILESTONE
}

enum AIRecommendationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// ==========================================
// MODELS
// ==========================================

/// Core User entity representing authenticated accounts
model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String
  role     Role   @default(STUDENT)

  dateOfBirth  DateTime?
  phone        String?
  profileImage String?
  isActive     Boolean   @default(true)
  isSuspended  Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 1-to-1 optional profiles depending on user role
  studentProfile StudentProfile?
  mentorProfile  MentorProfile?

  // Messages sent by this user across any mentorship
  sentMessages Message[]

  // Guardianship relations
  guardians Guardian[] @relation("LearnerGuardians")
  minors    Guardian[] @relation("GuardianUsers")

  // Interactions
  notifications       Notification[]
  complaintsSubmitted Complaint[]    @relation("Reporter")
  complaintsReceived  Complaint[]    @relation("ReportedUser")
}

/// Profile details specific to users with the STUDENT role
model StudentProfile {
  id         String  @id @default(uuid())
  userId     String  @unique
  bio        String? @db.Text
  education  String?
  skills     String? @db.Text
  interests  String? @db.Text
  careerGoal String?

  preferredLearningStyle String?
  preferredLanguage      String?
  budget                 Float?
  studyAvailability      String?
  experienceLevel        String?
  onboardingCompleted    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  goals             Goal[]
  mentorships       Mentorship[]
  payments          Payment[]
  assignments       Assignment[]           @relation("StudentAssignments")
  submissions       AssignmentSubmission[]
  aiRecommendations AIRecommendation[]
}

/// Profile details specific to users with the MENTOR role
model MentorProfile {
  id          String       @id @default(uuid())
  userId      String       @unique
  bio         String?      @db.Text
  expertise   String?      @db.Text
  experience  Int? // Experience in years
  hourlyRate  Float? // Hourly rate for mentoring sessions
  isAvailable Boolean      @default(true)
  status      MentorStatus @default(PENDING)

  language           String?
  linkedinUrl        String?
  profileImage       String?
  teachingExperience Int?
  teachingEvidence   String?    @db.Text
  employmentHistory  String?    @db.Text
  mentorType         MentorType @default(PROFESSIONAL)
  sessionFee         Float?
  verifiedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  mentorships      Mentorship[]
  availabilities   MentorAvailability[]
  topics           MentorTopic[]
  applications     MentorApplication[]
  peerApplications PeerMentorApplication[]
  credentials      Credential[]
  payouts          PayoutRecord[]
  assignments      Assignment[]            @relation("MentorAssignments")
}

/// Goal set by a student to track mentorship progress
model Goal {
  id          String     @id @default(uuid())
  studentId   String
  title       String
  description String?    @db.Text
  status      GoalStatus @default(ACTIVE)
  targetDate  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relationships
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  milestones Milestone[]

  @@index([studentId])
}

/// Actionable milestone or sub-task under a student's goal
model Milestone {
  id          String          @id @default(uuid())
  goalId      String
  title       String
  description String?         @db.Text
  status      MilestoneStatus @default(PENDING)
  dueDate     DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Relationships
  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
}

/// Mentorship connection between a student and a mentor
model Mentorship {
  id        String           @id @default(uuid())
  studentId String
  mentorId  String
  status    MentorshipStatus @default(ACTIVE)
  startedAt DateTime?        @default(now())
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  // Relationships
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  mentor      MentorProfile  @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  sessions    Session[]
  messages    Message[]
  assignments Assignment[]

  @@index([studentId])
  @@index([mentorId])
}

/// Mentoring session scheduled under an active mentorship
model Session {
  id           String        @id @default(uuid())
  mentorshipId String
  scheduledAt  DateTime
  duration     Int // Duration in minutes
  status       SessionStatus @default(SCHEDULED)
  meetingLink  String?
  topic        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relationships
  mentorship  Mentorship   @relation(fields: [mentorshipId], references: [id], onDelete: Cascade)
  payment     Payment?
  reviews     Review[]
  assignments Assignment[]
  complaints  Complaint[]

  @@index([mentorshipId])
}

/// Chat message exchanged within a mentorship
model Message {
  id           String   @id @default(uuid())
  senderId     String
  mentorshipId String
  content      String   @db.Text
  createdAt    DateTime @default(now())

  // Relationships
  sender     User       @relation(fields: [senderId], references: [id], onDelete: Cascade)
  mentorship Mentorship @relation(fields: [mentorshipId], references: [id], onDelete: Cascade)

  @@index([mentorshipId])
  @@index([senderId])
}

/// Recurring availability schedule set by a mentor
model MentorAvailability {
  id        String  @id @default(uuid())
  mentorId  String
  dayOfWeek String // e.g., "Monday", "Tuesday", etc.
  startTime String // e.g., "09:00"
  endTime   String // e.g., "17:00"
  isActive  Boolean @default(true)

  // Relationships
  mentor MentorProfile @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  @@index([mentorId])
}

// ==========================================
// NEW MODELS FOR PHASE 1
// ==========================================

model Guardian {
  id                 String  @id @default(uuid())
  userId             String // The user who is the guardian
  minorStudentId     String // The learner who is being guarded
  relationship       String // e.g., Parent, Legal Guardian
  phone              String?
  email              String?
  isVerified         Boolean @default(false)
  isMonitoringActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guardianUser User @relation("GuardianUsers", fields: [userId], references: [id], onDelete: Cascade)
  learner      User @relation("LearnerGuardians", fields: [minorStudentId], references: [id], onDelete: Cascade)

  @@unique([userId, minorStudentId])
}

model MentorApplication {
  id                  String          @id @default(uuid())
  mentorId            String
  status              MentorAppStatus @default(PENDING)
  professionalSummary String?         @db.Text
  expertise           String?         @db.Text
  experience          Int?
  teachingExperience  Int?
  linkedinUrl         String?
  languages           String?
  proposedSessionFee  Float?

  rejectionReason String? @db.Text
  reviewNotes     String? @db.Text
  reviewerId      String?

  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  mentor      MentorProfile      @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  aiScreening AIScreeningResult?
  credentials Credential[]
}

model PeerMentorApplication {
  id              String          @id @default(uuid())
  mentorId        String
  status          MentorAppStatus @default(PENDING)
  eligibilityInfo String?         @db.Text

  rejectionReason String? @db.Text
  reviewNotes     String? @db.Text
  reviewerId      String?

  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  mentor      MentorProfile      @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  aiScreening AIScreeningResult?
}

model AIScreeningResult {
  id                String  @id @default(uuid())
  applicationId     String? @unique
  peerApplicationId String? @unique

  screeningStatus    String
  recommendation     String  @db.Text
  structuredFindings Json?
  riskFlags          Json?
  modelInfo          String?

  createdAt DateTime @default(now())

  application     MentorApplication?     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  peerApplication PeerMentorApplication? @relation(fields: [peerApplicationId], references: [id], onDelete: Cascade)
}

model Credential {
  id            String  @id @default(uuid())
  mentorId      String
  applicationId String?

  type                String
  title               String
  description         String?   @db.Text
  issuingOrganization String?
  issueDate           DateTime?
  expiryDate          DateTime?

  fileReference String?

  status                CredentialStatus @default(PENDING)
  adminVerificationInfo String?          @db.Text

  uploadedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  mentor      MentorProfile      @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  application MentorApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model Topic {
  id       String  @id @default(uuid())
  name     String  @unique
  category String?

  mentors MentorTopic[]
}

model MentorTopic {
  mentorId String
  topicId  String

  mentor MentorProfile @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  topic  Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([mentorId, topicId])
}

model Payment {
  id        String  @id @default(uuid())
  studentId String
  mentorId  String?
  sessionId String  @unique

  amount       Float
  platformFee  Float
  mentorAmount Float
  currency     String        @default("INR")
  status       PaymentStatus @default(CREATED)

  razorpayOrderId   String? @unique
  razorpayPaymentId String? @unique
  razorpaySignature String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  paidAt    DateTime?

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  payout  PayoutRecord?
}

model PayoutRecord {
  id        String @id @default(uuid())
  mentorId  String
  paymentId String @unique

  grossAmount Float
  platformFee Float
  netAmount   Float

  status     PayoutStatus @default(PENDING)
  providerId String?

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  mentor  MentorProfile @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  payment Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model Assignment {
  id           String  @id @default(uuid())
  mentorshipId String
  sessionId    String?
  mentorId     String
  studentId    String

  title        String
  description  String?          @db.Text
  instructions String?          @db.Text
  dueDate      DateTime?
  status       AssignmentStatus @default(ASSIGNED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mentorship  Mentorship             @relation(fields: [mentorshipId], references: [id], onDelete: Cascade)
  session     Session?               @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  mentor      MentorProfile          @relation("MentorAssignments", fields: [mentorId], references: [id], onDelete: Cascade)
  student     StudentProfile         @relation("StudentAssignments", fields: [studentId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]
}

model AssignmentSubmission {
  id           String @id @default(uuid())
  assignmentId String
  studentId    String

  content       String  @db.Text
  fileReference String?

  score    Float?
  feedback String?          @db.Text
  status   SubmissionStatus @default(SUBMITTED)

  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?

  assignment Assignment     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Review {
  id           String       @id @default(uuid())
  sessionId    String
  reviewerId   String
  revieweeId   String
  rating       Int
  comment      String?      @db.Text
  reviewerRole ReviewerRole

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, reviewerRole])
}

model Notification {
  id            String           @id @default(uuid())
  userId        String
  type          NotificationType
  title         String
  message       String           @db.Text
  isRead        Boolean          @default(false)
  referenceId   String?
  referenceType String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Complaint {
  id             String  @id @default(uuid())
  reporterId     String
  reportedUserId String?
  sessionId      String?

  targetType String? // SESSION, PAYMENT, etc.
  targetId   String? // Generic reference ID if not user/session

  category    ComplaintCategory
  description String            @db.Text
  status      ComplaintStatus   @default(OPEN)

  adminNotes   String? @db.Text
  resolution   String? @db.Text
  reviewedById String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  reporter     User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User?    @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  session      Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model FileAsset {
  id           String @id @default(uuid())
  ownerId      String
  originalName String
  storageKey   String
  mimeType     String
  size         Int
  category     String // e.g., PROFILE_IMAGE, CERTIFICATE, ASSIGNMENT

  createdAt DateTime @default(now())
}

model AIRecommendation {
  id        String                 @id @default(uuid())
  studentId String
  type      AIRecommendationType
  content   Json
  status    AIRecommendationStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
}
