// Prisma schema for MentorConnect – AI-Powered Goal-Based Mentoring Platform
// Configured for PostgreSQL database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  STUDENT
  MENTOR
  ADMIN
  GUARDIAN
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum MilestoneStatus {
  PENDING
  COMPLETED
}

enum MentorshipStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  MISSED
}

enum MentorStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MentorType {
  PROFESSIONAL
  PEER
}

enum PaymentStatus {
  CREATED
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

enum PayoutStatus {
  PENDING
  ELIGIBLE
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

enum RefundStatus {
  REQUESTED
  PENDING_GATEWAY
  PROCESSED
  FAILED
  REJECTED
  CANCELLED
}

enum RefundInitiator {
  STUDENT
  MENTOR
  ADMIN
  SYSTEM
}

enum RefundPolicyTier {
  STUDENT_EARLY_100
  STUDENT_STANDARD_50
  STUDENT_LATE_EXCEPTIONAL
  MENTOR_CANCELLATION_100
  MENTOR_NO_SHOW_100
  BOOKING_FAILURE_100
  COMPLAINT_UPHELD
  ADMIN_MANUAL
}

enum AssignmentStatus {
  ASSIGNED
  SUBMITTED
  REVIEWED
  RETURNED
}

enum SubmissionStatus {
  NOT_SUBMITTED
  SUBMITTED
  REVIEWED
  LATE
}

enum ComplaintStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum ComplaintCategory {
  INAPPROPRIATE_BEHAVIOR
  NO_SHOW
  PAYMENT_ISSUE
  OTHER
}

enum NotificationType {
  SESSION_REMINDER
  MENTORSHIP_REQUEST
  PAYMENT
  ASSIGNMENT
  COMPLAINT
  GENERAL
  REFUND
}

enum MentorAppStatus {
  PENDING
  AI_SCREENED
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum CredentialStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ReviewerRole {
  STUDENT
  MENTOR
}

enum AIRecommendationType {
  ROADMAP
  MENTOR
  MILESTONE
}

enum AIRecommendationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum VerificationRequestType {
  NEW_CERTIFICATE
  NEW_EXPERIENCE
  NEW_TEACHING_TOPIC
  NEW_QUALIFICATION
  OTHER_PROFESSIONAL_CLAIM
}

enum VerificationRequestStatus {
  PENDING
  AI_SCREENED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

// ==========================================
// MODELS
// ==========================================

/// Core User entity representing authenticated accounts
model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String
  role     Role   @default(STUDENT)

  dateOfBirth  DateTime?
  phone        String?
  profileImage String?
  isActive     Boolean   @default(true)
  isSuspended  Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Account Email Verification
  isEmailVerified    Boolean   @default(true)
  emailVerifiedAt    DateTime? @default(now())
  pendingEmail       String?
  emailOtpHash       String?
  emailOtpExpiry     DateTime?
  emailOtpAttempts   Int       @default(0)
  lastEmailOtpSentAt DateTime?

  // 1-to-1 optional profiles depending on user role
  studentProfile StudentProfile?
  mentorProfile  MentorProfile?

  // Messages sent by this user across any mentorship
  sentMessages Message[]

  // Guardianship relations
  guardians Guardian[] @relation("LearnerGuardians")
  minors    Guardian[] @relation("GuardianUsers")

  // Interactions
  notifications       Notification[]
  complaintsSubmitted Complaint[]    @relation("Reporter")
  complaintsReceived  Complaint[]    @relation("ReportedUser")
  complaintMessages   ComplaintMessage[]
  refundRequests      Refund[]       @relation("RefundRequests")
  refundReviews       Refund[]       @relation("RefundReviews")
}

/// Profile details specific to users with the STUDENT role
model StudentProfile {
  id         String  @id @default(uuid())
  userId     String  @unique
  bio        String? @db.Text
  education  String?
  skills     String? @db.Text
  interests  String? @db.Text
  careerGoal String?

  // Minor-specific education details
  gradeLevel       String?
  schoolName       String?
  favoriteSubjects String?

  preferredLearningStyle String?
  preferredLanguage      String?
  budget                 Float?
  studyAvailability      String?
  experienceLevel        String?
  onboardingCompleted    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  goals             Goal[]
  mentorships       Mentorship[]
  payments          Payment[]
  assignments       Assignment[]           @relation("StudentAssignments")
  submissions       AssignmentSubmission[]
  aiRecommendations AIRecommendation[]
}

/// Profile details specific to users with the MENTOR role
model MentorProfile {
  id          String       @id @default(uuid())
  userId      String       @unique
  bio         String?      @db.Text
  expertise   String?      @db.Text
  experience  Int? // Experience in years
  hourlyRate  Float? // Hourly rate for mentoring sessions
  isAvailable Boolean      @default(true)
  status      MentorStatus @default(PENDING)

  language           String?
  linkedinUrl        String?
  profileImage       String?
  teachingExperience Int?
  teachingEvidence   String?    @db.Text
  employmentHistory  String?    @db.Text
  mentorType         MentorType @default(PROFESSIONAL)
  sessionFee         Float?
  verifiedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  mentorships      Mentorship[]
  availabilities   MentorAvailability[]
  topics           MentorTopic[]
  applications     MentorApplication[]
  peerApplications PeerMentorApplication[]
  credentials      Credential[]
  payouts          PayoutRecord[]
  assignments      Assignment[]            @relation("MentorAssignments")
  portfolio        MentorPortfolio?
  verificationRequests VerificationRequest[]
}

/// Goal set by a student to track mentorship progress
model Goal {
  id          String     @id @default(uuid())
  studentId   String
  title       String
  description String?    @db.Text
  status      GoalStatus @default(ACTIVE)
  targetDate  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relationships
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  milestones Milestone[]

  @@index([studentId])
}

/// Actionable milestone or sub-task under a student's goal
model Milestone {
  id          String          @id @default(uuid())
  goalId      String
  title       String
  description String?         @db.Text
  status      MilestoneStatus @default(PENDING)
  dueDate     DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Relationships
  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
}

/// Mentorship connection between a student and a mentor
model Mentorship {
  id        String           @id @default(uuid())
  studentId String
  mentorId  String
  status    MentorshipStatus @default(ACTIVE)
  startedAt DateTime?        @default(now())
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  // Relationships
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  mentor      MentorProfile  @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  sessions    Session[]
  messages    Message[]
  assignments Assignment[]

  @@index([studentId])
  @@index([mentorId])
}

/// Mentoring session scheduled under an active mentorship
model Session {
  id           String        @id @default(uuid())
  mentorshipId String
  scheduledAt  DateTime
  duration     Int // Duration in minutes
  status       SessionStatus @default(SCHEDULED)
  meetingLink  String?
  topic        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relationships
  mentorship  Mentorship   @relation(fields: [mentorshipId], references: [id], onDelete: Cascade)
  payment     Payment?
  reviews     Review[]
  assignments Assignment[]
  complaints  Complaint[]
  refunds     Refund[]

  @@index([mentorshipId])
}

/// Chat message exchanged within a mentorship
model Message {
  id           String   @id @default(uuid())
  senderId     String
  mentorshipId String
  content      String   @db.Text
  createdAt    DateTime @default(now())

  // Relationships
  sender     User       @relation(fields: [senderId], references: [id], onDelete: Cascade)
  mentorship Mentorship @relation(fields: [mentorshipId], references: [id], onDelete: Cascade)

  @@index([mentorshipId])
  @@index([senderId])
}

/// Recurring availability schedule set by a mentor
model MentorAvailability {
  id        String  @id @default(uuid())
  mentorId  String
  dayOfWeek String // e.g., "Monday", "Tuesday", etc.
  startTime String // e.g., "09:00"
  endTime   String // e.g., "17:00"
  isActive  Boolean @default(true)

  // Relationships
  mentor MentorProfile @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  @@index([mentorId])
}

// ==========================================
// NEW MODELS FOR PHASE 1
// ==========================================

model Guardian {
  id                 String    @id @default(uuid())
  name               String?   // Guardian full name
  userId             String?   // Optional: if linked to a registered user account
  minorStudentId     String    // The learner who is being guarded
  relationship       String    // e.g., Parent, Legal Guardian, Other
  phone              String?
  email              String?
  isVerified         Boolean   @default(false)
  emailVerifiedAt    DateTime?
  phoneVerifiedAt    DateTime?
  isMonitoringActive Boolean   @default(true)

  // Verification & Security
  verificationTokenHash   String?
  verificationTokenExpiry DateTime?
  verificationSentAt      DateTime?

  // OTP Verification
  otpHash                 String?
  otpExpiry               DateTime?
  otpAttempts             Int       @default(0)
  otpMethod               String?   // EMAIL or PHONE
  lastOtpSentAt           DateTime?
  verificationMethod      String?   // EMAIL, PHONE, or MAGIC_LINK

  // Consent
  consentStatus        String    @default("PENDING") // PENDING, GRANTED, REVOKED
  consentTimestamp     DateTime?
  consentPolicyVersion String?   @default("1.0")

  // Notification Preferences
  notificationPreferences Json?

  // Revocation
  accessRevokedAt     DateTime?
  accessRevokedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guardianUser User? @relation("GuardianUsers", fields: [userId], references: [id], onDelete: SetNull)
  learner      User  @relation("LearnerGuardians", fields: [minorStudentId], references: [id], onDelete: Cascade)

  accessTokens  GuardianAccessToken[]
  notifications Notification[]

  @@index([minorStudentId])
  @@index([email])
}

model GuardianAccessToken {
  id         String    @id @default(uuid())
  guardianId String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@index([guardianId])
  @@index([tokenHash])
}

model MentorApplication {
  id                  String          @id @default(uuid())
  mentorId            String
  status              MentorAppStatus @default(PENDING)
  professionalSummary String?         @db.Text
  expertise           String?         @db.Text
  experience          Int?
  teachingExperience  Int?
  linkedinUrl         String?
  languages           String?
  proposedSessionFee  Float?

  // Extended professional fields & claims
  employmentHistory          String? @db.Text
  teachingExperienceDetails  String? @db.Text
  education                  String? @db.Text
  skills                     String? @db.Text
  certifications             String? @db.Text
  achievements               String? @db.Text
  topics                     String? @db.Text
  otherInfo                  String? @db.Text

  rejectionReason String? @db.Text
  reviewNotes     String? @db.Text
  reviewerId      String?

  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  mentor      MentorProfile      @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  aiScreening AIScreeningResult?
  credentials Credential[]
}

model PeerMentorApplication {
  id              String          @id @default(uuid())
  mentorId        String
  status          MentorAppStatus @default(PENDING)
  eligibilityInfo String?         @db.Text

  rejectionReason String? @db.Text
  reviewNotes     String? @db.Text
  reviewerId      String?

  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  mentor      MentorProfile      @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  aiScreening AIScreeningResult?
}

model AIScreeningResult {
  id                String  @id @default(uuid())
  applicationId     String? @unique
  peerApplicationId String? @unique

  screeningStatus    String
  recommendation     String  @db.Text
  structuredFindings Json?
  riskFlags          Json?
  modelInfo          String?

  createdAt DateTime @default(now())

  application     MentorApplication?     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  peerApplication PeerMentorApplication? @relation(fields: [peerApplicationId], references: [id], onDelete: Cascade)
}

model Credential {
  id            String  @id @default(uuid())
  mentorId      String
  applicationId String?

  type                String
  title               String
  description         String?   @db.Text
  issuingOrganization String?
  issueDate           DateTime?
  expiryDate          DateTime?

  fileReference String?

  // Claim ↔ Evidence Linkage
  claimType            String?   // e.g., TEACHING_EXPERIENCE, EMPLOYMENT_HISTORY, EDUCATION, CERTIFICATION, ACHIEVEMENT, OTHER
  claimDescription     String?   // Specific claim being supported

  // AI Verification details for this document & claim
  aiVerificationResult String?   // SUPPORTED, PARTIALLY_SUPPORTED, UNSUPPORTED, UNABLE_TO_VERIFY
  aiConfidence         String?   // HIGH, MEDIUM, LOW
  aiReasoning          String?   @db.Text
  aiEvidenceFound      String?   @db.Text

  status                CredentialStatus @default(PENDING)
  adminVerificationInfo String?          @db.Text

  uploadedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  mentor      MentorProfile      @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  application MentorApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model MentorPortfolio {
  id                 String   @id @default(uuid())
  mentorId           String   @unique
  headline           String?
  introduction       String?  @db.Text
  about              String?  @db.Text
  teachingApproach   String?  @db.Text
  mentoringApproach  String?  @db.Text
  experienceSummary  String?  @db.Text
  teachingSummary    String?  @db.Text
  skills             Json?
  highlights         Json?
  education          Json?
  certifications     Json?
  achievements       Json?
  isGenerated        Boolean  @default(true)
  generatedAt        DateTime @default(now())
  updatedAt          DateTime @updatedAt

  mentor             MentorProfile @relation(fields: [mentorId], references: [id], onDelete: Cascade)
}

model Topic {
  id       String  @id @default(uuid())
  name     String  @unique
  category String?

  mentors MentorTopic[]
}

model MentorTopic {
  mentorId String
  topicId  String

  mentor MentorProfile @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  topic  Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([mentorId, topicId])
}

model Payment {
  id        String  @id @default(uuid())
  studentId String
  mentorId  String?
  sessionId String  @unique

  amount       Float
  platformFee  Float
  mentorAmount Float
  currency     String        @default("INR")
  status       PaymentStatus @default(CREATED)

  razorpayOrderId   String? @unique
  razorpayPaymentId String? @unique
  razorpaySignature String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  paidAt    DateTime?

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  payout  PayoutRecord?
  refunds Refund[]
}

model PayoutRecord {
  id        String @id @default(uuid())
  mentorId  String
  paymentId String @unique

  grossAmount Float
  platformFee Float
  netAmount   Float

  status     PayoutStatus @default(PENDING)
  providerId String?

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  mentor  MentorProfile @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  payment Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model Assignment {
  id           String  @id @default(uuid())
  mentorshipId String
  sessionId    String?
  mentorId     String
  studentId    String

  title        String
  description  String?          @db.Text
  instructions String?          @db.Text
  dueDate      DateTime?
  status       AssignmentStatus @default(ASSIGNED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mentorship  Mentorship             @relation(fields: [mentorshipId], references: [id], onDelete: Cascade)
  session     Session?               @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  mentor      MentorProfile          @relation("MentorAssignments", fields: [mentorId], references: [id], onDelete: Cascade)
  student     StudentProfile         @relation("StudentAssignments", fields: [studentId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]
}

model AssignmentSubmission {
  id           String @id @default(uuid())
  assignmentId String
  studentId    String

  content       String  @db.Text
  fileReference String?

  score    Float?
  feedback String?          @db.Text
  status   SubmissionStatus @default(SUBMITTED)

  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?

  assignment Assignment     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Review {
  id           String       @id @default(uuid())
  sessionId    String
  reviewerId   String
  revieweeId   String
  rating       Int
  comment      String?      @db.Text
  reviewerRole ReviewerRole

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, reviewerRole])
}

model Notification {
  id            String           @id @default(uuid())
  userId        String
  type          NotificationType
  title         String
  message       String           @db.Text
  isRead        Boolean          @default(false)
  referenceId   String?
  referenceType String?

  channel        String?   @default("IN_APP") // IN_APP, EMAIL, SMS
  deliveryStatus String?   @default("DELIVERED") // DELIVERED, SENT, FAILED, PENDING
  recipientEmail String?
  guardianId     String?
  sentAt         DateTime?
  errorMessage   String?

  createdAt DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  guardian Guardian? @relation(fields: [guardianId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([guardianId])
  @@index([referenceId])
}

model Complaint {
  id             String  @id @default(uuid())
  reporterId     String
  reportedUserId String?
  sessionId      String?

  targetType String? // SESSION, PAYMENT, etc.
  targetId   String? // Generic reference ID if not user/session

  category    ComplaintCategory
  description String            @db.Text
  status      ComplaintStatus   @default(OPEN)

  adminNotes   String? @db.Text
  resolution   String? @db.Text
  reviewedById String?

  reportedUserResponse    String? @db.Text
  reportedUserRespondedAt DateTime?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  reporter     User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User?    @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  session      Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  messages     ComplaintMessage[]
  refunds      Refund[]
}

model ComplaintMessage {
  id          String   @id @default(uuid())
  complaintId String
  senderId    String
  content     String   @db.Text
  createdAt   DateTime @default(now())

  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  sender      User      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([complaintId])
  @@index([senderId])
}

model FileAsset {
  id           String @id @default(uuid())
  ownerId      String
  originalName String
  storageKey   String
  mimeType     String
  size         Int
  category     String // e.g., PROFILE_IMAGE, CERTIFICATE, ASSIGNMENT

  createdAt DateTime @default(now())
}

model AIRecommendation {
  id        String                 @id @default(uuid())
  studentId String
  type      AIRecommendationType
  content   Json
  status    AIRecommendationStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model VerificationRequest {
  id               String                    @id @default(uuid())
  mentorId         String
  type             VerificationRequestType
  status           VerificationRequestStatus @default(PENDING)

  // Data for the request
  title            String?
  description      String?                   @db.Text
  institution      String?
  startDate        DateTime?
  endDate          DateTime?

  // Uploaded evidence or links
  evidenceFiles    String?                   @db.Text
  evidenceLinks    String?                   @db.Text

  // AI Verification details
  aiResult         String?
  aiConfidence     String?
  aiReasoning      String?                   @db.Text
  aiEvidenceFound  String?                   @db.Text

  // Admin review
  adminNotes       String?                   @db.Text
  rejectionReason  String?                   @db.Text
  reviewerId       String?

  submittedAt      DateTime                  @default(now())
  reviewedAt       DateTime?
  updatedAt        DateTime                  @updatedAt

  mentor           MentorProfile             @relation(fields: [mentorId], references: [id], onDelete: Cascade)
}

model Refund {
  id                String           @id @default(uuid())
  refundReference   String           @unique
  paymentId         String
  sessionId         String?
  complaintId       String?

  amount            Float
  currency          String           @default("INR")
  status            RefundStatus     @default(REQUESTED)
  policyTier        RefundPolicyTier
  initiator         RefundInitiator

  reason            String           @db.Text
  studentNotes      String?          @db.Text
  adminNotes        String?          @db.Text
  failureReason     String?          @db.Text

  // Razorpay Gateway Details
  razorpayRefundId  String?          @unique
  razorpayPaymentId String?
  idempotencyKey    String?          @unique
  gatewayResponse   Json?

  // Actor References
  requestedById     String?
  reviewedById      String?

  // Timestamps
  requestedAt       DateTime         @default(now())
  reviewedAt        DateTime?
  processedAt       DateTime?
  failedAt          DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  payment           Payment          @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  session           Session?         @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  complaint         Complaint?       @relation(fields: [complaintId], references: [id], onDelete: SetNull)
  requestedBy       User?            @relation("RefundRequests", fields: [requestedById], references: [id], onDelete: SetNull)
  reviewedBy        User?            @relation("RefundReviews", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@index([sessionId])
  @@index([status])
  @@index([refundReference])
}
