# Server Configuration
PORT=5000
NODE_ENV=development

# Client Origin
CLIENT_URL=http://localhost:5173

# Database Connection (PostgreSQL with Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://username:password@localhost:5432/mentorconnect_db?schema=public"

# Authentication (JWT)
JWT_SECRET="replace_with_a_secure_random_secret_key"
JWT_EXPIRES_IN="7d"

# AI Service Configuration (Placeholder for future implementation)
AI_SERVICE_API_KEY=""
AI_SERVICE_MODEL="gemini-pro"
