# Server Configuration
PORT=5000
NODE_ENV=development

# Client Origin
CLIENT_URL=http://localhost:5173

# Database Connection (PostgreSQL with Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://username:password@localhost:5432/mentorconnect_db?schema=public"

# Authentication (JWT)
JWT_SECRET="replace_with_a_secure_random_secret_key"
JWT_EXPIRES_IN="7d"

# AI Service Configuration (Placeholder for future implementation)
AI_SERVICE_API_KEY=""
AI_SERVICE_MODEL="gemini-pro"

# Razorpay Credentials
RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_SECRET"

# Email SMTP Provider Configuration (Nodemailer)
# Supports Gmail SMTP or any standard SMTP server (SendGrid, Mailgun, AWS SES, custom SMTP, etc.)
# For Gmail:
#   1. Enable 2-Step Verification on your Google Account (myaccount.google.com/security)
#   2. Generate an App Password (myaccount.google.com/apppasswords) under 'Security' -> 'App passwords'
#   3. Use the 16-character generated password as SMTP_PASS (do NOT use your normal Gmail account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM="MentorConnect <your-email@gmail.com>"
